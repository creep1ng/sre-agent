        "redaction": {
          "$ref": "#/$defs/successfulRedaction"
        }
      }
    },
    {
      "properties": {
        "content_state": {
          "const": "redaction_failed"
        },
        "redaction": {
          "$ref": "#/$defs/failedRedaction"
        }
      },
      "not": {
        "properties": {
          "redacted_content": true
        },
        "required": [
          "redacted_content"
        ]
      }
    }
  ],
  "$defs": {
    "auditRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_version",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "hmac-sha-256"
        },
        "key_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "incident_ref": {
          "$ref": "#/$defs/auditRef"
        },
        "run_ref": {
          "$ref": "#/$defs/auditRef"
        },
        "task_ref": {
          "$ref": "#/$defs/auditRef"
        },
        "trace_ref": {
          "$ref": "#/$defs/auditRef"
        }
      }
    },
    "partial401Identity": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "principal_ref": {
          "$ref": "#/$defs/auditRef"
        },
        "principal_kind": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "principal_status": {
          "enum": [
            "active",
            "inactive"
          ]
        },
        "credential_ref": {
          "$ref": "#/$defs/auditRef"
        }
      },
      "oneOf": [
        {
          "required": [
            "principal_ref",
            "principal_kind",
            "principal_status"
          ],
          "properties": {
            "principal_ref": true,
            "principal_kind": true,
            "principal_status": true,
            "credential_ref": true
          }
        },
        {
          "required": [
            "credential_ref"
          ],
          "properties": {
            "principal_ref": false,
            "principal_kind": false,
            "principal_status": false,
            "credential_ref": true
          }
        }
      ]
    },
    "authenticatedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_ref",
        "principal_kind",
        "principal_status",
        "credential_ref",
        "authenticated_at"
      ],
      "properties": {
        "principal_ref": {
          "$ref": "#/$defs/auditRef"
        },
        "principal_kind": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "principal_status": {
          "enum": [
            "active",
            "inactive"
          ]
        },
        "credential_ref": {
          "$ref": "#/$defs/auditRef"
        },
        "authenticated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "resourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_type",
        "resource_ref"
      ],
      "properties": {
        "resource_type": {
          "enum": [
            "llm_model",
            "mcp_server",
            "mcp_tool",
            "skill",
            "bok_collection",
            "administrative_control"
          ]
        },
        "resource_ref": {
          "$ref": "#/$defs/auditRef"
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_ref",
        "router",
        "provider_ref"
      ],
      "properties": {
        "model_ref": {
          "$ref": "#/$defs/auditRef"
        },
        "router": {
          "const": "openrouter"
        },
        "provider_ref": {
          "$ref": "#/$defs/auditRef"
        }
      }
    },
    "untrustedIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "incident",
            "model_alias",
            "resource",
            "run",
            "task",
            "trace"
          ]
        },
        "ref": {
          "$ref": "#/$defs/auditRef"
        }
      }
    },
    "redactedContent": {
      "oneOf": [
        {
          "$ref": "#/$defs/fullyRedacted"
        },
        {
          "$ref": "#/$defs/sanitizedText"
        }
      ]
    },
    "fullyRedacted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation"
      ],
      "properties": {
        "representation": {
          "const": "fully_redacted"
        }
      }
    },
    "sanitizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation",
        "text"
      ],
      "properties": {
        "representation": {
          "const": "sanitized_text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      }
    },
    "allowDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason_code",
        "grant_ref"
      ],
      "properties": {
        "decision": {
          "const": "allow"
        },
        "reason_code": {
          "const": "grant_matched"
        },
        "policy_ref": {
          "$ref": "#/$defs/auditRef"
        },
        "grant_ref": {
          "$ref": "#/$defs/auditRef"
        }
      }
    },
    "denyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason_code"
      ],
      "properties": {
        "decision": {
          "const": "deny"
        },
        "reason_code": {
          "const": "no_matching_grant"
        }
      }
    },
    "absentRedaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "result",
        "source_class",
        "categories",
        "match_count",
        "sink_eligible"
      ],
      "properties": {
        "policy_version": {
          "const": "redaction-1.0.0"
        },
        "result": {
          "const": "success"
        },
        "source_class": {
          "const": "none"
        },
        "categories": {
          "type": "array",
          "maxItems": 0
        },
        "match_count": {
          "const": 0
        },
        "sink_eligible": {
          "const": false
        }
      }
    },
    "successfulRedaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "result",
        "source_class",
        "categories",
        "match_count",
        "sink_eligible"
      ],
      "properties": {
        "policy_version": {
          "const": "redaction-1.0.0"
        },
        "result": {
          "const": "success"
        },
        "source_class": {
          "enum": [
            "llm_input",
            "llm_response",
            "mcp_log",
            "sandbox_output",
            "command_output",
            "tool_arguments",
            "tool_result",
            "free_content"
          ]
        },
        "categories": {
          "$ref": "#/$defs/categories"
        },
        "match_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "sink_eligible": {
          "const": true
        },
        "tool_schema_version": {
          "const": "1.0.0"
        }
      }
    },
    "successfulLlmRedaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "result",
        "source_class",
        "categories",
        "match_count",
        "sink_eligible"
      ],
      "properties": {
        "policy_version": {
          "const": "redaction-1.0.0"
        },
        "result": {
          "const": "success"
        },
        "source_class": {
          "enum": [
            "llm_input",
            "llm_response"
          ]
        },
        "categories": {
          "$ref": "#/$defs/categories"
        },
        "match_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "sink_eligible": {
          "const": true
        }
      }
    },
    "failedRedaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "result",
        "source_class",
        "categories",
        "match_count",
        "sink_eligible"
      ],
      "properties": {
        "policy_version": {
          "const": "redaction-1.0.0"
        },
        "result": {
          "const": "failed"
        },
        "source_class": {
          "enum": [
            "llm_input",
            "llm_response",
            "mcp_log",
            "sandbox_output",
            "command_output",
            "tool_arguments",
            "tool_result",
            "free_content"
          ]
        },
        "categories": {
          "$ref": "#/$defs/categories"
        },
        "match_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "sink_eligible": {
          "const": false
        },
        "tool_schema_version": {
          "const": "1.0.0"
        }
      }
    },
    "categories": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "credential",
          "personal_data",
          "provider_secret",
          "configured_pattern",
          "unsafe_structure",
          "uncertain"
        ]
      }
    }
  }
}
