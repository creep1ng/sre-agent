                },
                "response_status": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 299
                },
                "retryable": {
                  "const": false
                },
                "authoritative_acceptance": {
                  "const": "accepted"
                }
              }
            },
            {
              "properties": {
                "outcome": {
                  "const": "error"
                },
                "reason_code": {
