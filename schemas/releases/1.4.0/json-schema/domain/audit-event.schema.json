                      "type": "integer",
                      "minimum": 200,
                      "maximum": 299
                    },
                    {
                      "enum": [
                        400,
                        401,
                        403,
                        404,
                        409,
                        422,
                        502
                      ]
                    }
                  ]
                },
                "retryable": {
                  "const": false
                },
                "authoritative_acceptance": {
                  "const": "accepted"
                }
              }
            },
            {
              "properties": {
                "outcome": {
                  "const": "error"
                },
                "reason_code": {
                  "const": "audit_unavailable"
                },
                "response_status": {
                  "const": 503
                },
                "retryable": {
                  "const": true
                },
                "authoritative_acceptance": {
                  "const": "rejected"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "validation",
              "audit"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "identity": false,
          "resource": false,
          "model_alias_ref": false,
          "policy_decision": false,
          "routing": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "authentication"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "resource": false,
          "model_alias_ref": false,
          "policy_decision": false,
          "routing": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "authentication"
          },
          "outcome": {
            "const": "success"
          }
        },
        "required": [
          "stage",
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "identity": {
            "$ref": "#/$defs/authenticatedIdentity"
          }
        },
        "required": [
          "identity"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "authorization",
              "routing",
              "upstream",
              "response"
            ]
          },
          "resource": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resource_type": {
                "const": "administrative_control"
              }
            },
            "required": [
              "resource_type"
            ]
          }
        },
        "required": [
          "stage",
          "resource"
        ]
      },
      "then": {
        "properties": {
          "identity": {
            "$ref": "#/$defs/authenticatedIdentity"
          },
          "resource": true,
          "model_alias_ref": false,
          "routing": false
        },
        "required": [
          "identity",
          "resource"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "authorization",
              "routing",
              "upstream",
              "response"
            ]
          },
          "resource": {
            "not": {
              "type": "object",
              "properties": {
                "resource_type": {
                  "const": "administrative_control"
                }
              },
              "required": [
                "resource_type"
              ]
            }
          }
        },
        "required": [
          "stage",
          "resource"
        ]
      },
      "then": {
        "properties": {
          "identity": {
            "$ref": "#/$defs/authenticatedIdentity"
          },
          "resource": true,
          "model_alias_ref": true
        },
        "required": [
          "identity",
          "resource",
          "model_alias_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "authorization"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "routing": false
        },
        "oneOf": [
          {
            "properties": {
              "outcome": {
                "const": "success"
              },
              "reason_code": {
                "const": "grant_matched"
              },
              "policy_decision": {
                "$ref": "#/$defs/allowDecision"
              }
            },
            "required": [
              "outcome",
              "reason_code",
              "policy_decision"
            ]
          },
          {
            "properties": {
              "outcome": {
                "const": "denied"
              },
              "reason_code": {
                "const": "no_matching_grant"
              },
              "policy_decision": {
                "$ref": "#/$defs/denyDecision"
              }
            },
            "required": [
