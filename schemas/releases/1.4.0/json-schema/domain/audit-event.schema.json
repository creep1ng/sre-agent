{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-agent:schema:audit-event:1.4.0",
  "title": "AuditEvent",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "event_id",
    "occurred_at",
    "operation",
    "action",
    "stage",
    "outcome",
    "reason_code",
    "response_status",
    "retryable",
    "correlation",
    "redaction",
    "content_state",
    "authoritative_acceptance",
    "ordinary_result",
    "exporter_result"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "oneOf": [
        {
          "format": "uuid"
        },
        {
          "pattern": "^cor_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {
      "enum": [
        "audit.accept",
        "audit.export",
        "audit.project",
        "audit.redact",
        "credentials.authenticate",
        "responses.create",
        "principals.create",
        "principals.get",
        "principals.list",
        "principals.status.replace",
        "credentials.issue",
        "credentials.list",
        "credentials.revoke",
        "credentials.rotate"
      ]
    },
    "action": {
      "enum": [
        "authenticate",
        "export",
        "invoke",
        "persist",
        "read_metadata",
        "redact",
        "admin.read",
        "admin.write"
      ]
    },
    "stage": {
      "enum": [
        "validation",
        "authentication",
        "authorization",
        "routing",
        "upstream",
        "response",
        "audit"
      ]
    },
    "outcome": {
      "enum": [
        "success",
        "denied",
        "error"
      ]
    },
    "reason_code": {
      "enum": [
        null,
        "audit_unavailable",
        "authentication_failed",
        "contract_validation_failed",
        "grant_matched",
        "no_matching_grant",
        "redaction_failed",
        "redaction_uncertain",
        "routing_unavailable",
        "upstream_failed",
        "upstream_invalid",
        "upstream_unavailable"
      ]
    },
    "authorization_denial_cause": {
      "enum": [
        null,
        "principal_inactive",
        "resource_missing",
        "resource_inactive",
        "grant_not_applicable"
      ]
    },
    "response_status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "retryable": {
      "type": "boolean"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "correlation": {
      "$ref": "#/$defs/correlation"
    },
    "identity": {
      "oneOf": [
        {
          "$ref": "#/$defs/partial401Identity"
        },
        {
          "$ref": "#/$defs/authenticatedIdentity"
        }
      ]
    },
    "resource": {
      "$ref": "#/$defs/resourceEvidence"
    },
    "model_alias_ref": {
      "$ref": "#/$defs/auditRef"
    },
    "policy_decision": {
      "oneOf": [
        {
          "$ref": "#/$defs/allowDecision"
        },
        {
          "$ref": "#/$defs/denyDecision"
        }
      ]
    },
    "routing": {
      "$ref": "#/$defs/routing"
    },
    "untrusted_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trust",
        "identifiers"
      ],
      "properties": {
        "trust": {
          "const": "untrusted"
        },
        "identifiers": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/untrustedIdentifier"
          }
        }
      }
    },
    "redaction": {
      "oneOf": [
        {
          "$ref": "#/$defs/absentRedaction"
        },
        {
          "$ref": "#/$defs/successfulRedaction"
        },
        {
          "$ref": "#/$defs/failedRedaction"
        }
      ]
    },
    "content_state": {
      "enum": [
        "absent",
        "redacted",
        "redaction_failed"
      ]
    },
    "redacted_content": {
      "$ref": "#/$defs/redactedContent"
    },
    "authoritative_acceptance": {
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "ordinary_result": {
      "enum": [
        "released",
        "suppressed"
      ]
    },
    "exporter_result": {
      "enum": [
        "not_attempted",
        "succeeded",
        "failed"
      ]
    },
    "correction_of_event_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "stage": {
              "const": "validation"
            },
            "outcome": {
              "const": "error"
            },
            "reason_code": {
              "type": "string"
            },
            "response_status": {
              "enum": [
                400,
                422
              ]
            },
            "retryable": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "stage": {
              "const": "authentication"
            }
          },
          "oneOf": [
            {
              "properties": {
                "outcome": {
                  "const": "success"
                },
                "reason_code": {
                  "type": "null"
                },
                "response_status": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 299
                },
                "retryable": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "outcome": {
                  "const": "error"
                },
                "reason_code": {
                  "type": "string"
                },
                "response_status": {
                  "const": 401
                },
                "retryable": {
                  "const": false
                },
                "identity": {
                  "$ref": "#/$defs/partial401Identity"
                }
              }
            }
          ]
        },
        {
          "properties": {
            "stage": {
              "const": "authorization"
            }
          },
          "oneOf": [
            {
              "properties": {
                "outcome": {
                  "const": "success"
                },
                "reason_code": {
                  "const": "grant_matched"
                },
                "response_status": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 299
                },
                "retryable": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "outcome": {
                  "const": "denied"
                },
                "reason_code": {
                  "const": "no_matching_grant"
                },
                "response_status": {
                  "const": 403
                },
                "retryable": {
                  "const": false
                }
              }
            }
          ]
        },
        {
          "properties": {
            "stage": {
              "const": "routing"
            }
          },
          "oneOf": [
            {
              "properties": {
                "outcome": {
                  "const": "success"
                },
                "reason_code": {
                  "type": "null"
                },
                "response_status": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 299
                },
                "retryable": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "outcome": {
                  "const": "error"
                },
                "reason_code": {
                  "type": "string"
                },
                "response_status": {
                  "const": 502
                },
                "retryable": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "outcome": {
                  "const": "error"
                },
                "reason_code": {
                  "type": "string"
                },
                "response_status": {
                  "enum": [
                    503,
                    504
                  ]
                },
                "retryable": {
                  "const": true
                }
              }
            }
          ]
        },
        {
          "properties": {
            "stage": {
              "const": "upstream"
            }
          },
          "oneOf": [
            {
              "properties": {
                "outcome": {
                  "const": "success"
                },
                "reason_code": {
                  "type": "null"
                },
                "response_status": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 299
                },
                "retryable": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "outcome": {
                  "const": "error"
                },
                "reason_code": {
                  "type": "string"
                },
                "response_status": {
                  "const": 502
                },
                "retryable": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "outcome": {
                  "const": "error"
                },
                "reason_code": {
                  "type": "string"
                },
                "response_status": {
                  "enum": [
                    503,
                    504
                  ]
                },
                "retryable": {
                  "const": true
                }
              }
            }
          ]
        },
        {
          "properties": {
            "stage": {
              "const": "response"
            }
          },
          "oneOf": [
            {
              "properties": {
                "outcome": {
                  "const": "success"
                },
                "reason_code": {
                  "type": "null"
                },
                "response_status": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 299
                },
                "retryable": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "outcome": {
                  "const": "error"
                },
                "reason_code": {
                  "type": "string",
                  "not": {
                    "enum": [
                      "grant_matched",
                      "no_matching_grant"
                    ]
                  }
                },
                "response_status": {
                  "const": 502
                },
                "retryable": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "outcome": {
                  "const": "error"
                },
                "reason_code": {
                  "type": "string",
                  "not": {
                    "enum": [
                      "grant_matched",
                      "no_matching_grant"
                    ]
                  }
                },
                "response_status": {
                  "enum": [
                    503,
                    504
                  ]
                },
                "retryable": {
                  "const": true
                }
              }
            }
          ]
        },
        {
          "properties": {
