      "then": {
        "oneOf": [
          {
            "properties": {
              "outcome": {
                "const": "success"
              },
              "policy_decision": {
                "$ref": "#/$defs/allowDecision"
              },
              "routing": true
            },
            "required": [
              "outcome",
              "policy_decision",
              "routing"
            ]
          },
          {
            "properties": {
              "outcome": {
                "const": "error"
              },
              "policy_decision": {
                "$ref": "#/$defs/allowDecision"
              },
              "routing": false
            },
            "required": [
              "outcome",
              "policy_decision"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "upstream",
              "response"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "success",
              "error"
            ]
          },
          "policy_decision": {
            "$ref": "#/$defs/allowDecision"
          },
          "routing": true
        },
        "required": [
          "outcome",
          "policy_decision",
          "routing"
        ]
      }
    },
    {
      "if": {
        "properties": {
