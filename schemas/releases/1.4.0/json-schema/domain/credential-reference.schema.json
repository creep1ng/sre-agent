{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:sre-agent:schema:credential-reference:1.4.0","title":"CredentialReference","type":"object","additionalProperties":false,"required":["credential_id","principal_id","prefix","status","created_at","expires_at","revoked_at"],"properties":{"credential_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{2,63}$"},"principal_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{2,63}$"},"prefix":{"type":"string","pattern":"^[A-Za-z0-9_-]{4,16}$"},"status":{"enum":["active","revoked"]},"created_at":{"type":"string","format":"date-time"},"expires_at":{"type":["string","null"],"format":"date-time"},"revoked_at":{"type":["string","null"],"format":"date-time"}}}
