{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:sre-agent:schema:credential-issuance:1.4.0","title":"CredentialIssuance","type":"object","unevaluatedProperties":false,"required":["credential","replaced_credential_id","secret_revealed"],"properties":{"credential":{"$ref":"urn:sre-agent:schema:credential-reference:1.4.0"},"replaced_credential_id":{"type":["string","null"],"pattern":"^[a-z][a-z0-9_-]{2,63}$"},"secret_revealed":{"type":"boolean"},"key":{"type":"string","pattern":"^sre_[A-Za-z0-9_-]{24,128}$"}},"if":{"properties":{"secret_revealed":{"const":true}},"required":["secret_revealed"]},"then":{"properties":{"key":true},"required":["key"]},"else":{"properties":{"key":false}}}
