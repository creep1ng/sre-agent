{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-agent:schema:resource-catalog-list:2.2.0",
  "title": "ResourceCatalogList",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "limit",
    "truncated"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "urn:sre-agent:schema:resource-catalog-entry:2.2.0"
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "truncated": {
      "type": "boolean"
    }
  }
}
