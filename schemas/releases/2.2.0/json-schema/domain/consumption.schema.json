{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-agent:schema:consumption:2.2.0",
  "title": "Consumption",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "availability",
    "source",
    "input_tokens",
    "output_tokens",
    "total_tokens",
    "billed_usd",
    "currency",
    "precision",
    "pricing_context"
  ],
  "properties": {
    "availability": {
      "enum": [
        "complete",
        "partial",
        "absent",
        "unavailable"
      ]
    },
    "source": {
      "const": "openrouter"
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "total_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "billed_usd": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64,
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "currency": {
      "enum": [
        "USD",
        null
      ]
    },
    "precision": {
      "enum": [
        "exact",
        null
      ]
    },
    "pricing_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/pricingContext"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "billed_usd": {
            "type": "null"
          }
        },
        "required": [
          "billed_usd"
        ]
      },
      "then": {
        "properties": {
          "currency": {
            "type": "null"
          },
          "precision": {
            "type": "null"
          },
          "pricing_context": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "billed_usd": {
            "type": "string"
          }
        },
        "required": [
          "billed_usd"
        ]
      },
      "then": {
        "properties": {
          "currency": {
            "const": "USD"
          },
          "precision": {
            "const": "exact"
          },
          "pricing_context": {
            "$ref": "#/$defs/pricingContext"
          }
        },
        "required": [
          "currency",
          "precision",
          "pricing_context"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "availability": {
            "const": "complete"
          }
        },
        "required": [
          "availability"
        ]
      },
      "then": {
        "properties": {
          "input_tokens": {
            "type": "integer"
          },
          "output_tokens": {
            "type": "integer"
          },
          "total_tokens": {
            "type": "integer"
          },
          "billed_usd": {
            "type": "string"
          },
          "currency": {
            "const": "USD"
          },
          "precision": {
            "const": "exact"
          },
          "pricing_context": {
            "$ref": "#/$defs/pricingContext"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "availability": {
            "const": "partial"
          }
        },
        "required": [
          "availability"
        ]
      },
      "then": {
        "allOf": [
          {
            "not": {
              "properties": {
                "input_tokens": {
                  "not": {
                    "type": "null"
                  }
                },
                "output_tokens": {
                  "not": {
                    "type": "null"
                  }
                },
                "total_tokens": {
                  "not": {
                    "type": "null"
                  }
                },
                "billed_usd": {
                  "not": {
                    "type": "null"
                  }
                },
                "currency": {
                  "not": {
                    "type": "null"
                  }
                },
                "precision": {
                  "not": {
                    "type": "null"
                  }
                },
                "pricing_context": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "input_tokens",
                "output_tokens",
                "total_tokens",
                "billed_usd",
                "currency",
                "precision",
                "pricing_context"
              ]
            }
          },
          {
            "not": {
              "properties": {
                "input_tokens": {
                  "type": "null"
                },
                "output_tokens": {
                  "type": "null"
                },
                "total_tokens": {
                  "type": "null"
                },
                "billed_usd": {
                  "type": "null"
                },
                "currency": {
                  "type": "null"
                },
                "precision": {
                  "type": "null"
                },
                "pricing_context": {
                  "type": "null"
                }
              },
              "required": [
                "input_tokens",
                "output_tokens",
                "total_tokens",
                "billed_usd",
                "currency",
                "precision",
                "pricing_context"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "availability": {
            "enum": [
              "absent",
              "unavailable"
            ]
          }
        },
        "required": [
          "availability"
        ]
      },
      "then": {
        "properties": {
          "input_tokens": {
            "type": "null"
          },
          "output_tokens": {
            "type": "null"
          },
          "total_tokens": {
            "type": "null"
          },
          "billed_usd": {
            "type": "null"
          },
          "currency": {
            "type": "null"
          },
          "precision": {
            "type": "null"
          },
          "pricing_context": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "pricingContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "price_version"
      ],
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "price_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "unevaluatedProperties": false
}
