{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-agent:schema:usage-requests:2.8.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "filter",
    "items"
  ],
  "properties": {
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "incident_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "month": {
          "type": "string",
          "pattern": "^(?:(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-8][0-9]{3}|9[0-8][0-9]{2}|99[0-8][0-9]|999[0-8])-(?:0[1-9]|1[0-2])|9999-(?:0[1-9]|1[01]))$"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_id"
          ],
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "incident_id"
          ],
          "properties": {
            "incident_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "month"
          ],
          "properties": {
            "month": {
              "type": "string",
              "pattern": "^(?:(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-8][0-9]{3}|9[0-8][0-9]{2}|99[0-8][0-9]|999[0-8])-(?:0[1-9]|1[0-2])|9999-(?:0[1-9]|1[01]))$"
            }
          }
        }
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "month",
          "requested_assignment",
          "credited_model",
          "credited_provider",
          "attribution_status",
          "consumption",
          "navigation"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "requested_assignment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "availability": {},
              "alias": {},
              "model": {},
              "provider": {},
              "router": {}
            },
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "availability",
                  "alias",
                  "model",
                  "provider",
                  "router"
                ],
                "properties": {
                  "availability": {
                    "const": "available"
                  },
                  "alias": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "model": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._:-]+$"
                  },
                  "provider": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9._-]{0,63}$"
                  },
                  "router": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "availability",
                  "alias",
                  "model",
                  "provider",
                  "router"
                ],
                "properties": {
                  "availability": {
                    "const": "unavailable"
                  },
                  "alias": {
                    "const": null
                  },
                  "model": {
                    "const": null
                  },
                  "provider": {
                    "const": null
                  },
                  "router": {
                    "const": null
                  }
                }
              }
            ]
          },
          "credited_model": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "availability": {},
              "value": {}
            },
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "availability",
                  "value"
                ],
                "properties": {
                  "availability": {
                    "const": "available"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._:-]+$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "availability",
                  "value"
                ],
                "properties": {
                  "availability": {
                    "const": "unavailable"
                  },
                  "value": {
                    "const": null
                  }
                }
              }
            ]
          },
          "credited_provider": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "availability": {},
              "value": {}
            },
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "availability",
                  "value"
                ],
                "properties": {
                  "availability": {
                    "const": "available"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9._-]{0,63}$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "availability",
                  "value"
                ],
                "properties": {
                  "availability": {
                    "const": "unavailable"
                  },
                  "value": {
                    "const": null
                  }
                }
              }
            ]
          },
          "attribution_status": {
            "enum": [
              "available",
              "partial",
              "unavailable",
              "legacy"
            ],
            "description": "available means requested and credited attribution were persisted; partial means only some provider evidence is available; unavailable means invocation did not reach a snapshot-capable provider boundary; legacy means an older invocation has no persisted snapshot. Neither unavailable nor legacy attribution is reconstructed from a current alias."
          },
          "consumption": {
            "anyOf": [
              {
                "$ref": "urn:sre-agent:schema:consumption:2.8.0"
              },
              {
                "type": "null"
              }
            ]
          },
          "navigation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "unsupported"
              }
            }
          }
        },
        "unevaluatedProperties": false,
        "allOf": [
          {
            "if": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attribution_status"
              ],
              "properties": {
                "request_id": {},
                "month": {},
                "requested_assignment": {},
                "credited_model": {},
                "credited_provider": {},
                "attribution_status": {
                  "const": "available"
                },
                "consumption": {},
                "navigation": {}
              }
            },
            "then": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "request_id": {},
                "month": {},
                "requested_assignment": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "availability": {
                      "const": "available"
                    },
                    "alias": {},
                    "model": {},
                    "provider": {},
                    "router": {}
                  }
                },
                "credited_model": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "availability": {
                      "const": "available"
                    },
                    "value": {}
                  }
                },
                "credited_provider": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "availability": {
                      "const": "available"
                    },
                    "value": {}
                  }
                },
                "attribution_status": {},
                "consumption": {},
                "navigation": {}
              }
            }
          },
          {
            "if": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attribution_status"
              ],
              "properties": {
                "request_id": {},
                "month": {},
                "requested_assignment": {},
                "credited_model": {},
                "credited_provider": {},
                "attribution_status": {
                  "const": "legacy"
                },
                "consumption": {},
                "navigation": {}
              }
            },
            "then": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "request_id": {},
                "month": {},
                "requested_assignment": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "availability": {
                      "const": "unavailable"
                    },
                    "alias": {},
                    "model": {},
                    "provider": {},
                    "router": {}
                  }
                },
                "credited_model": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "availability": {
                      "const": "unavailable"
                    },
                    "value": {}
                  }
                },
                "credited_provider": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "availability": {
                      "const": "unavailable"
                    },
                    "value": {}
                  }
                },
                "attribution_status": {},
                "consumption": {},
                "navigation": {}
              }
            }
          },
          {
            "if": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attribution_status"
              ],
              "properties": {
                "request_id": {},
                "month": {},
                "requested_assignment": {},
                "credited_model": {},
                "credited_provider": {},
                "attribution_status": {
                  "const": "partial"
                },
                "consumption": {},
                "navigation": {}
              }
            },
            "then": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "request_id": {},
                "month": {},
                "requested_assignment": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "availability": {
                      "const": "available"
                    },
                    "alias": {},
                    "model": {},
                    "provider": {},
                    "router": {}
                  }
                },
                "credited_model": {},
                "credited_provider": {},
                "attribution_status": {},
                "consumption": {},
                "navigation": {}
              },
              "allOf": [
                {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "request_id": {},
                        "month": {},
                        "requested_assignment": {},
                        "credited_model": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "availability": {
                              "const": "unavailable"
                            },
                            "value": {}
                          }
                        },
                        "credited_provider": {},
                        "attribution_status": {},
                        "consumption": {},
                        "navigation": {}
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "request_id": {},
                        "month": {},
                        "requested_assignment": {},
                        "credited_model": {},
                        "credited_provider": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "availability": {
                              "const": "unavailable"
                            },
                            "value": {}
                          }
                        },
                        "attribution_status": {},
                        "consumption": {},
                        "navigation": {}
                      }
                    }
                  ]
                }
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attribution_status"
              ],
              "properties": {
                "request_id": {},
                "month": {},
                "requested_assignment": {},
                "credited_model": {},
                "credited_provider": {},
                "attribution_status": {
                  "const": "unavailable"
                },
                "consumption": {},
                "navigation": {}
              }
            },
            "then": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "request_id": {},
                "month": {},
                "requested_assignment": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "availability": {
                      "const": "unavailable"
                    },
                    "alias": {},
                    "model": {},
                    "provider": {},
                    "router": {}
                  }
                },
                "credited_model": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "availability": {
                      "const": "unavailable"
                    },
                    "value": {}
                  }
                },
                "credited_provider": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "availability": {
                      "const": "unavailable"
                    },
                    "value": {}
                  }
                },
                "attribution_status": {},
                "consumption": {},
                "navigation": {}
              }
            }
          }
        ]
      }
    }
  }
}
