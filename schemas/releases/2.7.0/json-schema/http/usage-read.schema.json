{
  "$id": "urn:sre-agent:schema:usage-read:2.7.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "filter",
    "request_count",
    "incident_runs",
    "months",
    "totals",
    "coverage"
  ],
  "properties": {
    "filter": {
      "type": "object",
      "unevaluatedProperties": false,
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_id"
          ],
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "incident_id"
          ],
          "properties": {
            "incident_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "month"
          ],
          "properties": {
            "month": {
              "type": "string",
              "pattern": "^(?:(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-8][0-9]{3}|9[0-8][0-9]{2}|99[0-8][0-9]|999[0-8])-(?:0[1-9]|1[0-2])|9999-(?:0[1-9]|1[01]))$"
            }
          }
        }
      ]
    },
    "request_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Distinct effective requests, not audit-event rows."
    },
    "incident_runs": {
      "type": "integer",
      "minimum": 0,
      "description": "Distinct runs in the selected scope; zero when no incident applies."
    },
    "months": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "month",
          "request_count"
        ],
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "request_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "cost"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost": {
          "type": "object",
          "unevaluatedProperties": false,
          "if": {
            "properties": {
              "amount": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "currency": {
                "const": null
              },
              "precision": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "currency": {
                "const": "USD"
              },
              "precision": {
                "const": "exact"
              }
            }
          },
          "required": [
            "amount",
            "currency",
            "nature",
            "precision",
            "price_versions"
          ],
          "properties": {
            "amount": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
              "description": "Exact billed USD decimal text; null when evidence cannot be combined."
            },
            "currency": {
              "enum": [
                "USD",
                null
              ]
            },
            "nature": {
              "const": "billed",
              "description": "The recorded value is billed provider cost, not an estimate."
            },
            "precision": {
              "enum": [
                "exact",
                null
              ]
            },
            "price_versions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "unevaluatedProperties": false,
      "description": "Counts describe distinct effective requests, never evidence rows. known + incomplete + unknown must equal request_count; this arithmetic is enforced by runtime and semantic conformance, not JSON Schema. Empty scopes are complete with zero counts and unavailable totals.",
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "complete"
            },
            "incomplete": {
              "const": 0
            },
            "unknown": {
              "const": 0
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "unknown"
            },
            "known": {
              "const": 0
            },
            "incomplete": {
              "const": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "partial"
            }
          },
          "anyOf": [
            {
              "properties": {
                "incomplete": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "properties": {
                "known": {
                  "type": "integer",
                  "minimum": 1
                },
                "unknown": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        }
      ],
      "required": [
        "status",
        "known",
        "incomplete",
        "unknown"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "known": {
          "type": "integer",
          "minimum": 0
        },
        "incomplete": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
