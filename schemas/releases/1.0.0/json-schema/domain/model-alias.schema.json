{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:sre-agent:schema:model-alias:1.0.0","title":"ModelAlias","type":"object","additionalProperties":false,"required":["model_alias_id","alias","concrete_model","router","inference_provider","status"],"properties":{"model_alias_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{2,63}$"},"alias":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,62}[a-z0-9]$"},"concrete_model":{"type":"string","pattern":"^[A-Za-z0-9._-]+/[A-Za-z0-9._:-]+$"},"router":{"type":"string","minLength":1,"maxLength":100},"inference_provider":{"type":"string","minLength":1,"maxLength":100},"status":{"enum":["active","inactive"]}}}
