{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:sre-agent:schema:idempotency-record:1.0.0","title":"IdempotencyRecord","type":"object","unevaluatedProperties":false,"required":["principal_id","method","canonical_path","key_digest","payload_sha256","binding","outcome","created_at","expires_at","transition_count"],"properties":{"principal_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{2,63}$"},"method":{"const":"POST"},"canonical_path":{"type":"string","pattern":"^/v1/[a-z0-9_/{}/-]+$","maxLength":200},"key_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"payload_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"binding":{"enum":["at_least_24h","principal_lifetime"]},"outcome":{"type":"object","additionalProperties":false,"required":["response_status","resource_id","replayed"],"properties":{"response_status":{"enum":[200,201]},"resource_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{2,63}$"},"replayed":{"type":"boolean"}}},"created_at":{"type":"string","format":"date-time"},"expires_at":{"type":["string","null"],"format":"date-time"},"transition_count":{"const":1}},"allOf":[{"if":{"properties":{"binding":{"const":"principal_lifetime"}},"required":["binding"]},"then":{"properties":{"expires_at":{"type":"null"}}},"else":{"properties":{"expires_at":{"type":"string","format":"date-time"}}}}]}
