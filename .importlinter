[importlinter]
root_package = sre_agent
include_external_packages = True

# ADR-009 (docs/adrs/ADR-009-core-ports-and-adapters.md): the core imports no framework and no
# adapter. Each ignore_imports line is a violation on main that a later layer of the #1023 stack
# removes; the lists only shrink, and no change adds a line to pass. One line covers every import
# of the named package by the named module, so a module that is listed may still add imports of
# the same package until its line goes.

[importlinter:contract:incident-does-not-use-concrete-adapters]
name = Incident core does not use concrete adapters
type = forbidden
source_modules =
    sre_agent.incident
forbidden_modules =
    sre_agent.persistence
    sre_agent.gateway
    sre_agent.control
    sre_agent.gate
    sre_agent.cli
    sre_agent.application
    fastapi
    starlette
    sqlalchemy
    psycopg
    httpx

[importlinter:contract:governance-does-not-use-concrete-adapters]
name = Governance does not use concrete adapters
type = forbidden
source_modules =
    sre_agent.governance
forbidden_modules =
    sre_agent.persistence
    sre_agent.gateway
    sre_agent.control
    sre_agent.gate
    sre_agent.cli
    sre_agent.application
    fastapi
    starlette
    sqlalchemy
    psycopg
    httpx

[importlinter:contract:persistence-does-not-use-delivery]
name = Persistence does not use delivery or composition
type = forbidden
source_modules =
    sre_agent.persistence
forbidden_modules =
    sre_agent.gateway
    sre_agent.control
    sre_agent.application

[importlinter:contract:incident-runtime-and-ports-avoid-frameworks]
name = Incident runtime and ports avoid framework dependencies
type = forbidden
source_modules =
    sre_agent.incident.runtime
    sre_agent.incident.persistence
forbidden_modules =
    fastapi
    sqlalchemy
    httpx

[importlinter:contract:investigator-cannot-reach-state]
name = Investigator reaches the gateway over HTTP only and cannot write state
type = forbidden
source_modules =
    sre_agent.investigator
forbidden_modules =
    sre_agent.persistence
    sre_agent.incident
    sre_agent.gateway
    sre_agent.control
    sre_agent.gate
    sre_agent.cli
    sre_agent.application
    fastapi
    starlette
    sqlalchemy
    psycopg
    httpx
ignore_imports =
    sre_agent.investigator.client -> httpx

[importlinter:contract:executor-is-isolated]
name = The deploy-executor reaches only the Docker Engine API and imports no other plane
type = forbidden
source_modules =
    sre_agent.executor
forbidden_modules =
    sre_agent.persistence
    sre_agent.gateway
    sre_agent.control
    sre_agent.application
    sre_agent.incident
    sre_agent.governance
    sre_agent.investigator
    sqlalchemy
    psycopg

[importlinter:contract:executor-decisions-avoid-frameworks]
name = The deploy-executor's decisions import no framework and no adapter of its process
type = forbidden
source_modules =
    sre_agent.executor.catalog
    sre_agent.executor.operations
    sre_agent.executor.signature
forbidden_modules =
    sre_agent.executor.app
    sre_agent.executor.docker
    sre_agent.executor.flags
    sre_agent.gate
    sre_agent.cli
    fastapi
    starlette
    httpx
ignore_imports =
    sre_agent.executor.operations -> sre_agent.executor.docker

[importlinter:contract:mcp-and-vocabulary-use-no-adapters]
name = MCP ownership and the vocabulary import no framework and no adapter
type = forbidden
source_modules =
    sre_agent.mcp
    sre_agent.vocabulary
forbidden_modules =
    sre_agent.persistence
    sre_agent.gateway
    sre_agent.control
    sre_agent.gate
    sre_agent.cli
    sre_agent.application
    fastapi
    starlette
    sqlalchemy
    psycopg
    httpx

[importlinter:contract:triage-uses-ports-only]
name = Triage reaches state and frameworks only through ports
type = forbidden
source_modules =
    sre_agent.triage
forbidden_modules =
    sre_agent.persistence
    sre_agent.gateway
    sre_agent.control
    sre_agent.gate
    sre_agent.cli
    sre_agent.application
    fastapi
    starlette
    sqlalchemy
    psycopg
    httpx
ignore_imports =
    sre_agent.triage.service -> sqlalchemy
    sre_agent.triage.service -> sre_agent.persistence.database
    sre_agent.triage.service -> sre_agent.persistence.incidents
    sre_agent.triage.service -> sre_agent.persistence.repositories
    sre_agent.triage.store -> sqlalchemy

