# / and /index.html without a query serve the Midnight landing, whose «Abrir la consola» opens
# /app/ (#870). The previous console keeps every address that carries a query, except the
# operations views /app already replaces (alerts, triage, war room), which redirect there.
# Decisions, postmortem and governance keep their page until they move. LEGACY_CONSOLE=keep
# serves the previous console at every old address, / included; the old console's suites run so.
map "${LEGACY_CONSOLE}:$arg_view:$arg_incident_id" $console_redirect {
    default "";
    "~^redirect:(alerts|triage):" /app/;
    "~^redirect:war-room:(?<war_room_incident>[A-Za-z0-9_.-]+)$" /app/incidentes/$war_room_incident;
    "~^redirect:war-room:" /app/incidentes;
}

map "${LEGACY_CONSOLE}:$args" $front_page {
    default /index.html;
    "redirect:" /landing/index.html;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # The workspace's output language (#717): the console writes its agent prompts with it.
    location = /workspace.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 200 '{"output_language":"${INVESTIGATOR_OUTPUT_LANGUAGE}"}';
    }

    # The landing's text/markdown alternate for agents (#870).
    location = /llms.txt {
        types { }
        default_type "text/markdown; charset=utf-8";
    }

    location /api/ {
        if ($http_sec_fetch_site = "cross-site") {
            return 403;
        }

        proxy_pass http://${API_UPSTREAM}/;
        proxy_http_version 1.1;
        # Starting an investigation run answers after the governed investigation itself: up to
        # six model turns of at most 45 s plus their tool calls. The default 60 s read timeout
        # cut that answer off with a 504 while the run went on.
        proxy_read_timeout 360s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie "";
        proxy_set_header Origin "";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Cache-Control "no-store" always;
    }

    # The new incident console (web/incident-console). Resolved per request, so the proxy and
    # the current console keep working when the console container is absent.
    location = /app {
        # Relative, so the redirect keeps the published host port.
        absolute_redirect off;
        return 301 /app/;
    }

    location /app/ {
        resolver 127.0.0.11 valid=10s;
        set $incident_console ${INCIDENT_CONSOLE_UPSTREAM};
        proxy_pass http://$incident_console;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Cookie "";
        add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'" always;
    }

    location ~ ^/(index\.html)?$ {
        absolute_redirect off;
        if ($console_redirect) {
            return 302 $console_redirect;
        }
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; object-src 'none'" always;
        try_files $front_page =404;
    }

    location / {
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; object-src 'none'" always;
        try_files $uri $uri/ =404;
    }
}
