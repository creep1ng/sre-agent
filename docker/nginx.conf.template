server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        if ($http_sec_fetch_site = "cross-site") {
            return 403;
        }

        proxy_pass http://${API_UPSTREAM}/;
        proxy_http_version 1.1;
        # Starting an investigation run answers after the governed investigation itself: up to
        # six model turns of at most 45 s plus their tool calls. The default 60 s read timeout
        # cut that answer off with a 504 while the run went on.
        proxy_read_timeout 360s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie "";
        proxy_set_header Origin "";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Cache-Control "no-store" always;
    }

    # The new incident console (web/incident-console). Resolved per request, so the proxy and
    # the current console keep working when the console container is absent.
    location = /app {
        # Relative, so the redirect keeps the published host port.
        absolute_redirect off;
        return 301 /app/;
    }

    location /app/ {
        resolver 127.0.0.11 valid=10s;
        set $incident_console ${INCIDENT_CONSOLE_UPSTREAM};
        proxy_pass http://$incident_console;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Cookie "";
        add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'" always;
    }

    location / {
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; object-src 'none'" always;
        try_files $uri $uri/ =404;
    }
}
