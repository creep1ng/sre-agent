# Project overrides for the pinned OpenTelemetry Demo environment.
# Passed AFTER the upstream .env so these values win.
# Rationale for each override lives in demo/manifest.yaml.

DEMO_VERSION=3.0.0
ENVOY_PORT=8090
PUBLIC_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:8090/otlp-http/v1/traces

# Upstream .env derives these from ENVOY_PORT while it is read. References here
# resolve against that earlier file first, so the port is written literally.
FRONTEND_PROXY_ADDR=frontend-proxy:8090
K6_TARGET_URL=http://frontend-proxy:8090
