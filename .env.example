# Local-only defaults. Override these values outside the repository for shared environments.
POSTGRES_DB=sre_agent
POSTGRES_USER=sre_agent
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://sre_agent:local-development-only@db:5432/sre_agent
API_PORT=8000
WEB_PORT=8080
POSTGRES_PORT=5432
ADMIN_HUMAN_API_KEY=<set-unique-sre_-prefixed-key-with-32-plus-characters>
DEMO_HUMAN_API_KEY=<set-unique-sre_-prefixed-key-with-32-plus-characters>
INCIDENT_HARNESS_API_KEY=<set-unique-sre_-prefixed-key-with-32-plus-characters>
RESTRICTED_HARNESS_API_KEY=<set-unique-sre_-prefixed-key-with-32-plus-characters>
TRIAGE_AGENT_MODEL=<lab/model>
TRIAGE_AGENT_PROVIDER=<provider>
REMEDIATION_AGENT_MODEL=<lab/model>
REMEDIATION_AGENT_PROVIDER=<provider>
# Language of the investigator's hypotheses, steps and summaries: es (default) or en.
INVESTIGATOR_OUTPUT_LANGUAGE=es
# Seconds the investigator waits for one MCP tool call, in (0, 30] (#719).
INVESTIGATOR_TOOL_TIMEOUT_SECONDS=30
AUDIT_HMAC_KEY=<set-long-random-audit-hmac-key>
# Secret Grafana's webhook contact point sends as a Bearer value (#765); empty disables intake.
ALERT_INTAKE_GRAFANA_SECRET=<set-long-random-grafana-intake-secret>
# Operator intake declares incidents for; empty records alerts and leaves them to the console.
ALERT_INTAKE_PRINCIPAL_ID=demo-human
# Key the gateway signs executor operations with (#743); the executor is unready without it.
DEPLOY_EXECUTOR_SIGNING_KEY=<set-long-random-executor-signing-key>
# The deploy-executor's change.write key (#770): scripts/provision_demo.py creates its principal
# and grant, and each rollback is recorded as a change event. Leave empty to record none.
DEPLOY_EXECUTOR_CHANGES_API_KEY=<set-unique-sre_-prefixed-key-with-32-plus-characters>
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_API_KEY=
OPENROUTER_TIMEOUT_SECONDS=30
# Optional OpenRouter host; must be https://. Plain http:// is accepted only with
# OPENROUTER_ALLOW_INSECURE_BASE_URL=1, which only the consumption E2E stand-in sets.
# OPENROUTER_BASE_URL=https://openrouter.ai
SRE_AGENT_APPLICATION_VERSION=
SRE_AGENT_CONTRACT_VERSION=2.7.0
SRE_AGENT_BUILD_REVISION=source-archive
RUN_OPENROUTER_LIVE_SMOKE=0
# Telegram channel (#766, profile `telegram`): the BotFather token stays in this ignored file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org

# Single-command setup (see docs/setup-sre.md); private literal inputs only.
SRE_OTEL_MODE=local
SRE_SETUP_PROJECT=sre-demo
SRE_MCP_NETWORK=sre-mcp-boundary
SRE_ENABLE_PAID_LLM=0
# Optional absolute DEMO_STATE_DIR; default: this checkout's .demo-state.
# Optional nonoverlapping SRE_RUNTIME_SUBNET and SRE_CONSUMER_SUBNET.
